[Unit]
Description=Vibe12 BACnet device Who-Is (devices_discovered.csv only)
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User={{ ansible_user }}
WorkingDirectory={{ bacnet_app_remote_dir }}
Environment=PYTHONPATH={{ bacnet_app_remote_dir }}
{% if bacnet_router_ip | default('') | length > 0 %}
ExecStart={{ bacnet_app_remote_dir }}/.venv/bin/python -m edge_bacnet.discover_devices \
  {{ bacnet_discover_range_low }} {{ bacnet_discover_range_high }} \
  -o {{ devices_discovered_path }} \
  --site-id {{ site_id }} \
  --building-id {{ building_id }} \
  --name {{ bacnet_device_name }} \
  --instance {{ bacnet_instance_id }} \
  --address {{ bacnet_edge_bind_address | default(bacnet_bind_address) }} \
  --route-aware \
  --network {{ bacnet_network | default(1) }} \
  --router-ip {{ bacnet_router_ip }} \
  --mstp-net {{ bacnet_mstp_net }} \
  --timeout {{ bacnet_discover_timeout | default(20) }}
{% else %}
ExecStart={{ bacnet_app_remote_dir }}/.venv/bin/python -m edge_bacnet.discover_devices \
  {{ bacnet_discover_range_low }} {{ bacnet_discover_range_high }} \
  -o {{ devices_discovered_path }} \
  --site-id {{ site_id }} \
  --building-id {{ building_id }} \
  --name {{ bacnet_device_name }} \
  --instance {{ bacnet_instance_id }} \
  --address {{ bacnet_edge_bind_address | default(bacnet_bind_address) }} \
  --timeout {{ bacnet_discover_timeout | default(20) }}
{% endif %}
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
