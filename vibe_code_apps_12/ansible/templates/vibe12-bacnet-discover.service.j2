[Unit]
Description=Vibe12 BACnet discovery (one-shot CSV export)
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User={{ ansible_user }}
WorkingDirectory={{ bacnet_app_remote_dir }}
Environment=PYTHONPATH={{ bacnet_app_remote_dir }}
ExecStart={{ bacnet_app_remote_dir }}/.venv/bin/python -m edge_bacnet.discover \
  {{ bacnet_discover_range_low }} {{ bacnet_discover_range_high }} \
  -o {{ points_csv_path }} \
  --site-id {{ site_id }} \
  --building-id {{ building_id }} \
  --name {{ bacnet_device_name }} \
  --instance {{ bacnet_instance_id }} \
  --address {{ bacnet_bind_address }}
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
