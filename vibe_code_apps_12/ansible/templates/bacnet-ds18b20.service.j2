[Unit]
Description=BACnet DS18B20 temperature server (BACpypes3 / vibe_code_apps_12)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User={{ ansible_user }}
Group={{ ansible_user }}
WorkingDirectory={{ bacnet_app_remote_dir }}
Environment=PYTHONUNBUFFERED=1
ExecStart={{ bacnet_app_remote_dir }}/.venv/bin/python {{ bacnet_app_remote_dir }}/temp_sensor_server.py \
  --name {{ bacnet_device_name }} \
  --instance {{ bacnet_instance_id }} \
  --address {{ bacnet_bind_address }} \
  --sample-interval {{ bacnet_sample_interval | default(2) }} \
  --aws-interval {{ aws_iot_publish_interval | default(60) }}{% if enable_aws_iot | default(false) %} \
  --aws-iot \
  --aws-endpoint {{ aws_iot_endpoint }} \
  --aws-cert {{ aws_iot_certs_remote_dir }}/{{ aws_iot_cert_filename }} \
  --aws-key {{ aws_iot_certs_remote_dir }}/{{ aws_iot_key_filename }} \
  --aws-client-id {{ aws_iot_client_id }} \
  --site-id {{ site_id }} \
  --building-id {{ building_id }} \
  --system-id {{ ds18b20_system_id | default('office') }} \
  --point-deg-c {{ ds18b20_point_deg_c | default('digital-temp-degC') }} \
  --point-deg-f {{ ds18b20_point_deg_f | default('digital-temp-degF') }} \
  --brick-class {{ ds18b20_brick_class | default('Zone_Air_Temperature_Sensor') }} \
  --brick-tag {{ ds18b20_brick_tag | default('') }} \
  --object-name-c {{ ds18b20_object_name_c | default('') | quote }} \
  --object-name-f {{ ds18b20_object_name_f | default('') | quote }}{% endif %}{% if fault_demo_mode | default(false) %} \
  --fault-demo{% endif %}{% if server_extra_args | length > 0 %} \
  {{ server_extra_args | join(' ') }}{% endif %}

Restart=on-failure
RestartSec=5

[Install]
WantedBy=multi-user.target
