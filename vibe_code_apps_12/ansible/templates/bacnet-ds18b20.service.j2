[Unit]
Description=BACnet DS18B20 temperature server (bacpymes3 / vibe_code_apps_12)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User={{ ansible_user }}
Group={{ ansible_user }}
WorkingDirectory={{ bacnet_app_remote_dir }}
Environment=PYTHONUNBUFFERED=1
ExecStart={{ bacnet_app_remote_dir }}/.venv/bin/python {{ bacnet_app_remote_dir }}/temp_sensor_server.py \
  --name {{ bacnet_device_name }} \
  --instance {{ bacnet_instance_id }} \
  --address {{ bacnet_bind_address }} \
  --sensor {{ sensor_backend }}{% if server_extra_args | length > 0 %} \
  {{ server_extra_args | join(' ') }}{% endif %}

Restart=on-failure
RestartSec=5

[Install]
WantedBy=multi-user.target
