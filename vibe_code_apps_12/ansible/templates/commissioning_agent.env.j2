# Copy to gateways.local.json and set real Tailscale/LAN edge_url values.

SITE_ID={{ site_id }}
BUILDING_ID={{ building_id }}
BACNET_BIND={{ bacnet_edge_bind_address | default(bacnet_bind_address) }}
BACNET_NAME={{ bacnet_edge_device_name | default(bacnet_device_name) }}
BACNET_INSTANCE={{ bacnet_instance_id }}
DISCOVER_LOW={{ bacnet_discover_range_low }}
DISCOVER_HIGH={{ bacnet_discover_range_high }}
DISCOVER_TIMEOUT={{ bacnet_discover_timeout | default(15) }}
{% if bacnet_router_ip | default('') | length > 0 %}
ROUTER_IP={{ bacnet_router_ip }}
MSTP_NET={{ bacnet_mstp_net }}
BACNET_NETWORK={{ bacnet_network | default(1) }}
{% endif %}
VIBE12_COMMISSION_TOKEN={{ commissioning_web_token | default('') }}
