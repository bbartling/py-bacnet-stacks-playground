---
# Copy to host_vars/bacnet_pi.yml for the boss Pi test bench (DS18B20 on GPIO).
# Building gateways should NOT use this file — defaults in group_vars/pi_bcn.yml are BACnet-only.

enable_ds18b20_gpio: true
enable_ds18b20_service: true
bacnet_device_name: PiTemp

site_id: demo
building_id: bens-office
ds18b20_system_id: office
ds18b20_point_deg_c: digital-temp-degC
ds18b20_point_deg_f: digital-temp-degF
ds18b20_brick_class: Zone_Air_Temperature_Sensor
ds18b20_brick_tag: BenOffice-ZAT
ds18b20_object_name_c: "Ben's office DS18B20 °C"
ds18b20_object_name_f: "Ben's office DS18B20 °F"
aws_iot_publish_interval: 60
aws_iot_client_id: vibe12-gpio-bacnet-pi
bacnet_edge_client_id: vibe12-edge-bacnet-pi

# enable_onewire_overlay: true  # uncomment if 1-Wire not enabled in raspi-config
