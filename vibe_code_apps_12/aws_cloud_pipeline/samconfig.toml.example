# =============================================================================
# Vibe12 cloud — SAM deploy config (TEMPLATE)
# =============================================================================
#
#   cp samconfig.toml.example samconfig.toml
#   nano samconfig.toml    # edit WebPassword + AuthSecret lines below
#
# samconfig.toml is GITIGNORED. Include it in your CloudShell tarball.
# Do NOT run `sam deploy --guided` after this file exists.
# =============================================================================

version = 0.1

[default.global.parameters]
stack_name = "vibe12cloud"

[default.build.parameters]
cached = true
parallel = true

[default.deploy.parameters]
capabilities = "CAPABILITY_IAM"
confirm_changeset = false
resolve_s3 = true
resolve_image_repos = true
region = "us-east-2"

# BACnet MQTT: vibe12/{site_id}/{building_id}/{system_id}/{point_id}/telemetry
# IoT rule (underscores only)
# DynamoDB row TTL (days)
# Bump every deploy so Lambdas refresh
# Product namespace (all sites/buildings)
# Dashboard login user
# *** SET YOUR PASSWORD ***
# *** SET 32+ CHAR RANDOM SECRET ***

# Optional: poll AWS IoT Core thing/client MQTT status on /api/edge-devices (Dashboard).
# Thing name may differ from MQTT client_id (lab Pi often uses client_id basicPubSub).
# Escape quotes inside the JSON string for SAM CLI.
# Use one space-separated string if IotEdgeThings JSON contains commas (TOML arrays split on commas).
# Example with two edge devices:
# parameter_overrides = "IotRuleName=vibe12_telemetry_ingest TtlDays=90 DeployRevision=6 IotTopicPrefix=vibe12 WebUsername=engineer WebPassword=REPLACE IotEdgeThings=[{\"site_id\":\"demo\",\"building_id\":\"bens-office\",\"thing_name\":\"\",\"client_id\":\"basicPubSub\",\"label\":\"Lab Pi\"}]"

parameter_overrides = [
  "IotRuleName=vibe12_telemetry_ingest",
  "TtlDays=90",
  "DeployRevision=6",
  "IotTopicPrefix=vibe12",
  "WebUsername=engineer",
  "WebPassword=REPLACE_WITH_YOUR_PASSWORD",
  "AuthSecret=REPLACE_WITH_LONG_RANDOM_SECRET_MIN_32_CHARS",
  "IotEdgeThings=[]",
]
