.ansible_venv/
__pycache__/
*.pyc
.aws-sam/

# SAM deploy secrets (copy from samconfig.toml.example)
aws_cloud_pipeline/samconfig.toml

# Doc build venv + artifacts
.docs-venv/
docs/_build/

# Wire captures (generated on edge by deploy --pcap)
captures/*.pcap
bacnet.pcap

# Codex wake config (copy from vibe12_agent_spec/cron_codex/env.example)
vibe12_agent_spec/cron_codex/.env
vibe12_agent_spec/cron_codex/logs/wake-*.log
vibe12_agent_spec/cron_codex/logs/last_wake_epoch
vibe12_agent_spec/cron_codex/state/context_since_last_wake.md
vibe12_agent_spec/cron_codex/state/context_since_last_wake.meta.json
vibe12_agent_spec/cron_codex/state/wake_prepare_dry_run.log

# AWS IoT Core experiments — certs/keys/zips (see aws_iot_core_test/.gitignore)
aws_iot_core_test/.env
aws_iot_core_test/*.pem
aws_iot_core_test/*.key
aws_iot_core_test/*.zip
aws_iot_core_test/certs/
aws_iot_certs/
