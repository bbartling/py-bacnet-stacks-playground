.ansible_venv/
__pycache__/
*.pyc
.aws-sam/

# Local Python virtualenvs (python3 -m venv .venv-test — never git add)
.venv/
.venv-test/
.venv-ci/
.venv-*/

# SAM deploy secrets (copy from samconfig.toml.example)
aws_cloud_pipeline/samconfig.toml
aws_cloud_pipeline/sam-params.local.toml
aws_cloud_pipeline/sam-params.local.json

# Commissioning dial-in dashboard
commissioning_web/gateways.local.json
commissioning_web/jobs/
commissioning_web/jobs/*.prompt.txt
commissioning_web/.session.token
commissioning_web/.server.pid
commissioning_web/.server.lock
commissioning_web/server.log

# Doc build venv + artifacts
.docs-venv/
docs/_build/

# Wire captures (generated on edge by deploy --pcap)
captures/*.pcap
bacnet.pcap

# Ansible — real IPs / per-site BACnet (templates: inventory.example.yml, host_vars/*.example.yml)
ansible/inventory.yml
ansible/host_vars/*.yml
!ansible/host_vars/*.example.yml

# Edge BACnet CSV backups with real site metadata (public shapes: edge_backup/_examples/)
edge_backup/local/
edge_backup/**/host.yml
!edge_backup/_examples/**/host.yml
!edge_backup/demo/**/host.yml

# Codex wake generated logs (see vibe12_agent_spec/.gitignore)
vibe12_agent_spec/cron_codex/.env

# AWS IoT Core experiments — certs/keys/zips (see aws_iot_core_test/.gitignore)
aws_iot_core_test/.env
aws_iot_core_test/*.pem
aws_iot_core_test/*.key
aws_iot_core_test/*.zip
aws_iot_core_test/certs/
aws_iot_certs/
