# Copy to .env (gitignored) and fill in from AWS IoT console / connect package.
# Do not commit .env or any .pem / .key files.

AWS_IOT_ENDPOINT=a2ab6ncd4xlhhr-ats.iot.us-east-2.amazonaws.com
AWS_IOT_CLIENT_ID=basicPubSub
AWS_IOT_TOPIC=sdk/test/python

# Paths to files after unzipping connect_device_package.zip in this folder:
AWS_IOT_CERT_PEM=vibe-code-app-12-temp-sensor.cert.pem
AWS_IOT_PRIVATE_KEY=vibe-code-app-12-temp-sensor.private.key
# AWS_IOT_ROOT_CA=root-CA.crt
