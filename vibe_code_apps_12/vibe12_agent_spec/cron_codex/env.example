# Copy to cron_codex/.env (gitignored)

VIBE12_REPO="/home/ben/py-bacnet-stacks-playground"
CODEX_CWD="/home/ben/py-bacnet-stacks-playground/vibe_code_apps_12"

# Models
MINI_MODEL="gpt-5.4-mini"
CRITIQUE_MODEL="gpt-5.5"

# Per wake: max mini invocations, then one critique (rewrites "Next for mini (ordered)")
MINI_INVOCATIONS_PER_WAKE=3
MINI_ALLOW_EARLY_STOP=true
SLEEP_BETWEEN_MINI_SEC=2

# Skip gpt-5.5 critique when repo porcelain is clean after minis
SKIP_CRITIQUE_WHEN_CLEAN=false

# bensserver: bwrap RTM_NEWADDR — TUI/wake auto-bypass; or set explicitly:
# VIBE12_CODEX_BYPASS_SANDBOX=true
# CODEX_DANGEROUSLY_BYPASS=true

VIBE12_CODEX_LOCK="/tmp/vibe12_codex_wake.lock"
MIN_MINUTES_BETWEEN_WAKES=0

# Optional after each wake (validate stack, deploy, etc.)
# POST_WAKE_HOOK='cd /home/ben/py-bacnet-stacks-playground/vibe_code_apps_12 && ./scripts/validate_cloud_pipeline.sh'

# Human pause: touch cron_codex/state/waiting_human
# Automation done: cron_codex/state/DONE_AUTOMATION
