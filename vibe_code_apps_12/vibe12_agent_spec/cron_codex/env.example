# Copy to cron_codex/.env (gitignored). Run vibe12_workspace_init.sh after clone.

VIBE12_REPO="/home/ben/py-bacnet-stacks-playground"
CODEX_CWD="/home/ben/py-bacnet-stacks-playground/vibe_code_apps_12"

MINI_MODEL="gpt-5.4-mini"
CRITIQUE_MODEL="gpt-5.5"

MINI_INVOCATIONS_PER_WAKE=3
MINI_ALLOW_EARLY_STOP=true
SLEEP_BETWEEN_MINI_SEC=2
SKIP_CRITIQUE_WHEN_CLEAN=false

# Anti-loop guardrails (defaults are conservative)
MIN_MINUTES_BETWEEN_WAKES=120
MAX_WAKES_PER_DAY=12
VIBE12_CRON_SCHEDULE="0 */2 * * *"
CRON_MARKER=VIBE12_CODEX_WAKE

# bensserver bwrap RTM_NEWADDR — commissioning chat defaults to bypass; or set:
# VIBE12_CODEX_BYPASS_SANDBOX=true
# VIBE12_COMMISSION_NO_BYPASS=true   # force sandbox (only if bwrap works)
# VIBE12_COMMISSION_SANDBOX=workspace-write

# Override caps only when you accept higher Codex spend (human decision):
# VIBE12_CRON_ALLOW_AGGRESSIVE=true

VIBE12_CODEX_LOCK="/tmp/vibe12_codex_wake.lock"

# POST_WAKE_HOOK='cd .../vibe_code_apps_12 && ./scripts/validate_cloud_pipeline.sh'

# TUI: chat-only by default (--json, final reply only). Full stream: --verbose
# VIBE12_TUI_QUIET=true
# VIBE12_MINI_MAX_RESUME_TURNS=6   # then fresh Codex session (avoids context junk)

# Copy once: templates/memory/job/lab_facts.example.md → memory/job/lab_facts.md
# Critique maintains: cron_codex/state/wake_task.md (one mission per wake)

# Validate cloud without reading samconfig (production-friendly):
# export WEB_PASSWORD='...'
# export WEB_USERNAME='engineer'
