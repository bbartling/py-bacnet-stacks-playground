# Local regenerable / heavy artifacts (models + data packs live on Drive / LAKESIDE_SITE_ROOT)
# Keep only small fixtures + READMEs in git so GH stays learnable.

.pytest_cache/
archive/**/__pycache__/
archive/ml/**/__pycache__/
archive/ml/artifacts/**
!archive/ml/artifacts/README.md
!archive/ml/README.md

ml/artifacts/**
!ml/artifacts/README.md
!ml/artifacts/INTEGRITY_INVENTORY_20260806.md
!ml/artifacts/fixtures/
!ml/artifacts/fixtures/**
!ml/artifacts/_quarantine_20260806/
!ml/artifacts/_quarantine_20260806/README.md

# Desktop ship outputs (populate via promote / Drive pack)
desktop/artifacts/**
!desktop/artifacts/.gitignore
!desktop/artifacts/README.md

# Rust build + packaged client binaries
desktop/target/
desktop/dist/**
!desktop/dist/.gitignore

**/__pycache__/
.ipynb_checkpoints/
*_executed.ipynb
*.pyc
.venv/
.site_root
config.py
.pytest_cache/
.mypy_cache/
.ruff_cache/

# Local notebook / OS noise
*.onnx
*.onnx.data
*.joblib
*.pt
*.pkl
*.parquet
!docs/blog/2026-08-15-rl-poc/data/*.parquet
