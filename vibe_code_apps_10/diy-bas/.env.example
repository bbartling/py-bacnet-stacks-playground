DIY_BACNET_URL=http://diy-bacnet-server:8080
BACNET_RPC_API_KEY=
DIY_SCHEDULE_OBJECT_NAME=occupancy-schedule
DIY_BAS_SHARED_OAT_POINT=
DIY_BAS_TREND_RETENTION_DAYS=30
DIY_BAS_DEFAULT_POLL_INTERVAL=30
DIY_BAS_MIN_POLL_INTERVAL=5
DIY_BAS_MAX_POLL_INTERVAL=900
DIY_BAS_POLL_FLUSH_SECONDS=10
DIY_BAS_POLL_BATCH_SIZE=50
DIY_BAS_STALE_MULTIPLIER=2.5
DIY_BAS_STALE_MIN_SECONDS=120
DIY_BAS_HIDE_GATEWAY_DEVICE=true
DJANGO_DEBUG=false
PORT=5050
DIY_BAS_HTTP_PORT=80
DIY_BACNET_SERVER_NAME=BACnetServer
DIY_BACNET_SERVER_INSTANCE=123456
# Use your real Pi/Linux username â€” do NOT use angle brackets (bash treats <name> as redirection when sourcing .env).
DIY_BACNET_SERVER_DIR=/home/pi/diy-bacnet-server
DIY_BAS_SECRET_KEY=change-me-in-production

DIY_BAS_SESSION_HOURS=24
DIY_BAS_SESSION_COOKIE_SECURE=false
DIY_BAS_SESSION_COOKIE_SAMESITE=Lax
DIY_BAS_SESSION_REFRESH_EACH_REQUEST=true

# Integrator = Django superuser + staff (full /admin/ and supervisory UI). Maintenance = read-only BAS by default (supervisory UI + /bas/manage/ list only).
DIY_BAS_ADMIN_USERNAME=integrator
DIY_BAS_ADMIN_PASSWORD=ChangeMeNow!123
DIY_BAS_MAINT_USERNAME=maintenance
DIY_BAS_MAINT_PASSWORD=ChangeMeNow!123
# When true, integrator + maintenance passwords and role flags are re-applied from this file on every app start (useful after changing passwords here or fixing a stale Pi DB). Set false once operators manage passwords only in Django admin or the UI.
DIY_BAS_BOOTSTRAP_REFRESH_PASSWORDS=true

DIY_BAS_LATEST_VALUES_FLUSH_SECONDS=300
DIY_BAS_LOG_LEVEL=INFO
DIY_BAS_LOG_TO_FILE=false
DIY_BAS_LOG_RETENTION_DAYS=30
DIY_BAS_AUDIT_RETENTION_DAYS=30
# Cleared alarm segments older than this are purged from SQLite (active alarms are never deleted here).
DIY_BAS_ALARM_EVENT_RETENTION_DAYS=90

