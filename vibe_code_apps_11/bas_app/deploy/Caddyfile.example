# Example: one URL for BAS head-end (UI + API) on port 80.
# Copy to /etc/caddy/Caddyfile snippet or include, adjust host/IP, reload Caddy.
# Requires bas_post_wake_stack (or manual) so 127.0.0.1:5173 and :8000 are up.
#
# After this, browse: http://YOUR_LAN_IP/
# Frontend uses same-origin API (see frontend/index.html apiBase logic).

http://192.168.204.18 {
	encode gzip

	handle /api/* {
		reverse_proxy 127.0.0.1:8000
	}
	handle /health {
		reverse_proxy 127.0.0.1:8000
	}
	handle /docs* {
		reverse_proxy 127.0.0.1:8000
	}
	handle /openapi.json {
		reverse_proxy 127.0.0.1:8000
	}
	handle /redoc* {
		reverse_proxy 127.0.0.1:8000
	}

	handle {
		reverse_proxy 127.0.0.1:5173
	}
}
