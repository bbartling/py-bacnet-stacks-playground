# Copy to `bas_build_spec/cron_codex/.env` and adjust. Do not commit secrets.

# Repository root containing `bas_build_spec/` (parent of app once created, or home for monorepo)
BAS_REPO="/home/ben"

# Codex working directory (usually same as BAS_REPO or app subfolder)
CODEX_CWD="/home/ben"

# Models (must match names your `codex` build supports: `codex exec --help`)
MINI_MODEL="gpt-5.4-mini"
CRITIQUE_MODEL="gpt-5.5"

# Per wake: **maximum** separate `codex exec` calls for mini (then one critique).
# Default 5 is gentler on quotas; raise (e.g. 10–15) for heavy pushes. See README “Tuning”.
# Each wake **plans** this many minis; fewer run only if MINI_ALLOW_EARLY_STOP=true and the
# model touches state/stop_mini_loop (see bas_wake.sh) after finishing the slice queue for this wake.
# Cheap test: MINI_INVOCATIONS_PER_WAKE=1 ./bin/bas_wake.sh
# With hourly cron, try 2–3 so each hour stays small.
MINI_INVOCATIONS_PER_WAKE=5

# If true, mini loop can end early when Codex runs: touch .../cron_codex/state/stop_mini_loop
MINI_ALLOW_EARLY_STOP=true

# Optional pause between mini invocations (seconds) to reduce burst load
SLEEP_BETWEEN_MINI_SEC=2

# Sandbox: read-only | workspace-write | danger-full-access
# If codex logs: bwrap: loopback: Failed RTM_NEWADDR: Operation not permitted — see cron_codex/README.md
# (kernel user namespaces, or try danger-full-access, or bypass on an isolated VM only).
CODEX_SANDBOX="workspace-write"

# Set true on an isolated build machine when probe still fails with bwrap RTM_NEWADDR (see codex_sandbox_probe.sh).
CODEX_DANGEROUSLY_BYPASS=false

# Lock and logs (writable by cron user)
BAS_CODEX_LOCK="/tmp/bas_codex_wake.lock"
BAS_CODEX_LOG_DIR="/home/ben/bas_build_spec/cron_codex/logs"

# Skip wake if last successful wake was within this many minutes (debounce)
MIN_MINUTES_BETWEEN_WAKES=0

# --- When acceptance is fully met (see README: marker file or legacy checklist) ---
# If true, bas_wake removes ONLY crontab lines containing CRON_MARKER (see crontab.example).
# Then writes state/DONE_AUTOMATION; future wakes exit immediately until that file is deleted.
REMOVE_CRON_WHEN_COMPLETE=false
CRON_MARKER=BAS_CODEX_WAKE

# Optional: space-separated GET URLs for `bin/bas_smoke.sh` (requires app already listening).
# Example after bas_app exists: BAS_SMOKE_GET_URLS="http://127.0.0.1:8000/health http://127.0.0.1:8000/api/demo/site"
# BAS_SMOKE_CURL_TIMEOUT=15
# BAS_SMOKE_GET_URLS=

# Long-lived runtime: systemd user units (default). Set BAS_RUNTIME=nohup for legacy nohup stack.
BAS_RUNTIME=systemd
# Optional before minis: refresh units / surface journal errors early.
# PRE_WAKE_HOOK=/home/ben/bas_build_spec/cron_codex/bin/bas_systemd_manage.sh ensure
# After each wake: install/restart units + health curls (preferred over Docker).
POST_WAKE_HOOK="/home/ben/bas_build_spec/cron_codex/bin/bas_systemd_manage.sh ensure-restart-health"

# Optional BACnet lab worker (human fills bind on the BACnet NIC — not field device IP):
# BAS_BACNET_LAB_VERIFY=true
# BAS_BACNET_APP_NAME=BensReadApp
# BAS_BACNET_DEVICE_INSTANCE=100
# BAS_BACNET_BIND_ADDRESS=192.168.204.18/24:47808
# BAS_BACNET_DISCOVERY_DEBUG=true
# Legacy nohup path only when BAS_RUNTIME=nohup:
# POST_WAKE_HOOK=/home/ben/bas_build_spec/cron_codex/bin/bas_post_wake_stack.sh
# POST_WAKE_STACK_RESTART=true
