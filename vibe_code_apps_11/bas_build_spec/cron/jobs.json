{
  "version": 2,
  "timezone": "America/Chicago",
  "notes": "Schedules: cron (5-field), every (minutes), at (ISO-8601 UTC). Gateway: bas_cron_scheduler.sh run-due",
  "jobs": [
    {
      "id": "bas-wake-hourly",
      "name": "Incremental Codex build wake (every 2h, UTC)",
      "enabled": true,
      "schedule": {
        "type": "cron",
        "expr": "0 */2 * * *"
      },
      "service": "bas_wake",
      "style": "isolated",
      "command": "/home/ben/py-bacnet-stacks-playground/vibe_code_apps_11/bas_build_spec/cron_codex/bin/bas_wake.sh",
      "env": {
        "BAS_CODEX_ENV_FILE": "/home/ben/py-bacnet-stacks-playground/vibe_code_apps_11/bas_build_spec/cron_codex/.env"
      }
    },
    {
      "id": "bas-stack-restart-post-wake",
      "name": "Restart live stack after wake (worker)",
      "enabled": true,
      "schedule": {
        "type": "every",
        "minutes": 0
      },
      "service": "systemd_restart",
      "style": "worker",
      "command": "/home/ben/py-bacnet-stacks-playground/vibe_code_apps_11/bas_build_spec/cron_codex/bin/bas_systemd_manage.sh",
      "args": [
        "ensure",
        "restart",
        "health"
      ],
      "note": "Invoked from bas_wake POST_WAKE_HOOK; not polled by scheduler when minutes=0."
    },
    {
      "id": "bas-bacnet-lab-verify",
      "name": "BACnet discovery gate (worker; human bind required)",
      "enabled": false,
      "schedule": {
        "type": "cron",
        "expr": "15 * * * *"
      },
      "service": "bacnet_lab_verify",
      "style": "worker",
      "command": "/home/ben/py-bacnet-stacks-playground/vibe_code_apps_11/bas_build_spec/cron_codex/bin/bas_bacnet_lab_verify.sh"
    },
    {
      "id": "bas-bacnet-auto-commission",
      "name": "Arm BACnet wire + Who-Is when AUTO_COMMISSION (worker; no Codex)",
      "enabled": true,
      "schedule": {
        "type": "every",
        "minutes": 5
      },
      "service": "bacnet_auto_commission",
      "style": "worker",
      "command": "/home/ben/py-bacnet-stacks-playground/vibe_code_apps_11/bas_build_spec/cron_codex/bin/bas_bacnet_auto_commission.sh",
      "note": "Requires BAS_BACNET_AUTO_COMMISSION=true in cron_codex/.env. Uses PHASE_NOTEPAD \u00a7 A/C; enables discovery poll."
    },
    {
      "id": "bas-bacnet-discovery-poll",
      "name": "BACnet Who-Is poll every 5 min (worker; no Codex)",
      "enabled": true,
      "schedule": {
        "type": "every",
        "minutes": 5
      },
      "service": "bacnet_discovery_poll",
      "style": "worker",
      "command": "/home/ben/py-bacnet-stacks-playground/vibe_code_apps_11/bas_build_spec/cron_codex/bin/bas_bacnet_discovery_poll.sh",
      "note": "Enable after bas_bacnet_authorize_wire.sh + .env bind vars. Writes memory/integrations/bacnet_discovery_latest.json; rough-in UI reads it."
    },
    {
      "id": "bas-smoke-health",
      "name": "HTTP smoke (worker)",
      "enabled": false,
      "schedule": {
        "type": "every",
        "minutes": 30
      },
      "service": "bas_smoke",
      "style": "worker",
      "command": "/home/ben/py-bacnet-stacks-playground/vibe_code_apps_11/bas_build_spec/cron_codex/bin/bas_smoke.sh"
    }
  ]
}
