[Unit]
Description=BAS head-end frontend dev server (Vite)
After=network-online.target bas-backend.service
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=__BAS_APP__/frontend
Environment=BAS_VITE_HOST=0.0.0.0
Environment=BAS_VITE_PORT=5173
ExecStart=/usr/bin/bash -lc 'if [[ -x node_modules/.bin/vite ]]; then exec npm run dev -- --host 0.0.0.0 --port 5173; elif [[ -f package.json ]]; then exec npm run dev -- --host 0.0.0.0 --port 5173; else exec python3 -m http.server 5173 --bind 0.0.0.0; fi'
Restart=on-failure
RestartSec=3

[Install]
WantedBy=default.target
