# Local Python env (PDF/spec tooling — do not commit)
env/
venv/
.venv/
__pycache__/
*.py[cod]
.pytest_cache/
.mypy_cache/

# Cron / Codex secrets and runtime (see also cron_codex/.gitignore)
cron_codex/.env
cron_codex/demo_auth.env
cron_codex/logs/*.log
cron/jobs-state.json
cron/runs/*
!cron/runs/.gitkeep

# Generated / local
scratch/
*.log
.DS_Store

# Spec / PDF build outputs (regenerate locally; do not commit)
_build/
pdf/

# Post-wake stack PID files (runtime only)
cron_codex/state/*.pid

# Optional local pandoc+typst installs (see repo root .gitignore comment)
tools/bin/

# Editor / OS junk
*~
*.swp
Thumbs.db
