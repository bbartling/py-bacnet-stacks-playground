# Slipstream Sketchbox credentials (never commit this file)
# Sign up / log in at https://www.sketchbox.io/
# Paste into vibe_code_apps_20/.env

SKETCHBOX_EMAIL=
SKETCHBOX_PASSWORD=
SKETCHBOX_BASE_URL=https://www.sketchbox.io

# headed = watch the browser; headless = CI-ish
SKETCHBOX_HEADED=1
SKETCHBOX_SLOW_MO_MS=50
