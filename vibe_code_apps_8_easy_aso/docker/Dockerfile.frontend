# Build React SPA (BASE /app8/) and serve with nginx, no Node in production image.
FROM node:22-bookworm-slim AS build
WORKDIR /src
COPY frontend/package.json frontend/package-lock.json ./
RUN npm install --include=dev --ignore-scripts \
    && chmod 755 /src/node_modules/.bin/* \
    && chmod 755 /src/node_modules/typescript/bin/* 2>/dev/null || true
COPY frontend/ .
ENV VITE_BASE_PATH=/app8
RUN node_modules/.bin/tsc -b && node_modules/.bin/vite build

FROM nginx:1.27-alpine
COPY docker/nginx/default.conf /etc/nginx/conf.d/default.conf
COPY --from=build /src/dist /usr/share/nginx/html/app8
EXPOSE 80
