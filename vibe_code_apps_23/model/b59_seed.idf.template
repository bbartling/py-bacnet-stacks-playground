Version, {{ENERGYPLUS_VERSION}};

Building,
  {{BUILDING_NAME}},          !- Name
  0.0,                        !- North Axis {deg}
  City,                       !- Terrain
  0.04,                       !- Loads Convergence Tolerance Value
  0.4,                        !- Temperature Convergence Tolerance Value {deltaC}
  FullExterior,               !- Solar Distribution
  25,                         !- Maximum Number of Warmup Days
  6;                          !- Minimum Number of Warmup Days

Timestep, 4;

SimulationControl,
  No,                         !- Do Zone Sizing Calculation
  No,                         !- Do System Sizing Calculation
  No,                         !- Do Plant Sizing Calculation
  No,                         !- Run Simulation for Sizing Periods
  Yes;                        !- Run Simulation for Weather File Run Periods

RunPeriod,
  {{RUN_PERIOD_NAME}},
  {{BEGIN_MONTH}}, {{BEGIN_DAY}}, {{END_MONTH}}, {{END_DAY}},
  UseWeatherFile, UseWeatherFile, No, Yes, Yes, No;

! SOURCE FACT (B59-FLOORS): calibration scope is the third/fourth office floors.
! UNRESOLVED (B59-OFFICE-AREA): floor area and geometry must be reconciled before
! detailed Zone, BuildingSurface:Detailed, and FenestrationSurface:Detailed objects are added.
! UNRESOLVED (B59-ZONE-MAP): do not add zones before sensor/thermal-zone mapping is evidenced.
! SOURCE FACT (B59-UFAD): model must eventually represent UFAD and four RTU service groups.
! UNRESOLVED: RTU capacities, OA controls, UFT behavior, envelope, schedules, and setpoints.
