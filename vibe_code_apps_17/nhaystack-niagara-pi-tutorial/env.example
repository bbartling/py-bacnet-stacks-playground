# Copy this file to .env and edit values.
# Do not commit .env with a real password.

export JACE_HOST="192.168.204.11"
export HAYSTACK_USER="open_fdd"
export HAYSTACK_PASS="replace-me"
export HAYSTACK_BASE="https://${JACE_HOST}/haystack"

# Observed lab station (Niagara 4 / N4):
#   productVersion 4.15.3.28
#   moduleVersion  3.3.0.0 (nHaystack)
#   serverName     v4Fifteen
#   haystackVersion 2.0
# Workbench: open_fdd → Authentication Scheme Name = HTTPBasicScheme

