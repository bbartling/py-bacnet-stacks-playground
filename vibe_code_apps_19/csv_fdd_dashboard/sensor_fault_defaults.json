{
  "schema_version": "1.0",
  "description": "Configurable HVAC sensor QA defaults — imperial primary for Building 100; metric included for reference. Tune per site/climate.",
  "persistence": {
    "min_fault_minutes": 15,
    "min_samples": 1,
    "startup_suppression_minutes": 10,
    "mode_change_suppression_minutes": 10,
    "flatline_window_hours": 4.0,
    "flatline_min_delta_f": 0.15,
    "flatline_min_delta_c": 0.08
  },
  "temperature_air": {
    "outdoor_air_temp": {
      "logical_aliases": ["oat"],
      "hard_range_ip": [-60, 130],
      "hard_range_si": [-51.1, 54.4],
      "normal_range_ip": [null, null],
      "normal_range_si": [null, null],
      "max_roc_per_hour_ip": 30,
      "max_roc_per_hour_si": 16.7,
      "spike_max_delta_ip_5min": 36,
      "spike_max_delta_si_5min": 20,
      "notes": "Regional override for extreme climates. Compare to weather reference when available."
    },
    "return_air_temp": {
      "logical_aliases": ["rat"],
      "hard_range_ip": [40, 100],
      "hard_range_si": [4.4, 37.8],
      "normal_range_ip": [65, 85],
      "normal_range_si": [18.3, 29.4],
      "max_roc_per_hour_ip": 10,
      "max_roc_per_hour_si": 5.6,
      "spike_max_delta_ip_5min": 12,
      "spike_max_delta_si_5min": 6.7
    },
    "mixed_air_temp": {
      "logical_aliases": ["mat"],
      "hard_range_ip": [-20, 110],
      "hard_range_si": [-28.9, 43.3],
      "normal_range_ip": [null, null],
      "normal_range_si": [null, null],
      "max_roc_per_hour_ip": 60,
      "max_roc_per_hour_si": 33.3,
      "spike_max_delta_ip_5min": 25,
      "spike_max_delta_si_5min": 14,
      "plausibility": {
        "must_be_between_oat_and_rat_when_fan_on": true,
        "deadband_ip": 4,
        "deadband_si": 2.2,
        "oat_rat_min_split_ip": 5,
        "oat_rat_min_split_si": 2.8
      }
    },
    "supply_air_temp": {
      "logical_aliases": ["sat"],
      "hard_range_ip": [30, 150],
      "hard_range_si": [-1.1, 65.6],
      "normal_range_ip": [45, 120],
      "normal_range_si": [7.2, 48.9],
      "max_roc_per_hour_ip": 120,
      "max_roc_per_hour_si": 66.7,
      "spike_max_delta_ip_5min": 40,
      "spike_max_delta_si_5min": 22,
      "plausibility": {
        "sat_mat_max_diff_when_coils_off_ip": 4,
        "sat_mat_max_diff_when_coils_off_si": 2.2,
        "coil_off_pct": 10
      }
    },
    "zone_temp": {
      "logical_aliases": ["zone_temp", "space_temp"],
      "hard_range_ip": [40, 100],
      "hard_range_si": [4.4, 37.8],
      "normal_range_ip": [65, 80],
      "normal_range_si": [18.3, 26.7],
      "max_roc_per_hour_ip": 10,
      "max_roc_per_hour_si": 5.6,
      "spike_max_delta_ip_5min": 12,
      "spike_max_delta_si_5min": 6.7
    }
  },
  "percentage_points": {
    "damper_position": {
      "logical_aliases": ["oa_damper_cmd", "oa_damper_pos", "oad_cmd", "oad_pos"],
      "hard_range_percent": [-5, 105],
      "preferred_fault_logic": "command_feedback_mismatch",
      "mismatch_deadband_percent": 10,
      "mismatch_minutes": 15
    },
    "valve_position": {
      "logical_aliases": ["cooling_cmd", "heating_cmd", "clg", "htg"],
      "hard_range_percent": [-5, 105],
      "preferred_fault_logic": "command_feedback_or_no_thermal_response",
      "mismatch_deadband_percent": 10,
      "mismatch_minutes": 15
    },
    "fan_speed": {
      "logical_aliases": ["fan_cmd", "fan_pct"],
      "hard_range_percent": [-5, 105],
      "preferred_fault_logic": "command_feedback_mismatch",
      "mismatch_deadband_percent": 10,
      "mismatch_minutes": 10
    }
  },
  "humidity": {
    "zone_rh": {
      "hard_range": [0, 100],
      "normal_range": [20, 70],
      "max_roc_percent_rh_per_hour": 20,
      "spike_max_delta_10min": 5
    },
    "duct_or_outdoor_rh": {
      "hard_range": [0, 100],
      "max_roc_percent_rh_per_hour": 40,
      "spike_max_delta_10min": 5
    }
  },
  "co2": {
    "zone_co2": {
      "hard_range_ppm": [350, 5000],
      "normal_review_range_ppm": [400, 2000],
      "max_roc_ppm_per_hour": 1500,
      "spike_max_delta_ppm_10min": 300
    },
    "outdoor_co2": {
      "hard_range_ppm": [300, 800],
      "max_roc_ppm_per_hour": 300
    }
  },
  "hydronic_temperature": {
    "chilled_water_temp": {
      "hard_range_ip": [30, 80],
      "hard_range_si": [-1.1, 26.7],
      "normal_range_ip": [38, 60],
      "normal_range_si": [3.3, 15.6],
      "max_roc_per_hour_ip": 20,
      "max_roc_per_hour_si": 11.1
    },
    "hot_water_temp": {
      "hard_range_ip": [40, 220],
      "hard_range_si": [4.4, 104.4],
      "normal_range_ip": [80, 200],
      "normal_range_si": [26.7, 93.3],
      "max_roc_per_hour_ip": 60,
      "max_roc_per_hour_si": 33.3
    }
  },
  "pressure": {
    "duct_static": {
      "hard_range_in_wc": [-1, 8],
      "hard_range_pa": [-249, 1993],
      "max_roc_in_wc_per_hour": 2,
      "max_roc_pa_per_hour": 498
    },
    "building_pressure": {
      "hard_range_in_wc": [-0.25, 0.25],
      "hard_range_pa": [-62, 62],
      "max_roc_in_wc_per_hour": 0.1,
      "max_roc_pa_per_hour": 25
    },
    "filter_dp": {
      "hard_range_in_wc": [0, 5],
      "hard_range_pa": [0, 1245],
      "max_roc_in_wc_per_hour": 0.5,
      "max_roc_pa_per_hour": 125
    }
  },
  "units": {
    "primary": "imperial",
    "temperature": "fahrenheit",
    "note": "All runtime checks use hard_range_ip / max_roc_per_hour_ip unless units.primary is metric"
  }
}
