{
  "schema_version": "1.0",
  "description": "BAS point mapping for AHU economizer FDD. Each logical point: required | preferred | optional | not_available",
  "logical_points": {
    "timestamp": {"role": "required", "description": "UTC or local historian timestamp"},
    "fan_cmd": {"role": "required", "description": "Supply fan speed or command 0-100%"},
    "fan_status": {"role": "preferred", "description": "Fan proof/status"},
    "oat": {"role": "required", "description": "Outdoor air dry-bulb °F"},
    "rat": {"role": "required", "description": "Return air dry-bulb °F"},
    "mat": {"role": "required", "description": "Mixed air dry-bulb °F"},
    "sat": {"role": "required", "description": "Supply air dry-bulb °F"},
    "sat_sp": {"role": "preferred", "description": "Supply air temperature setpoint °F"},
    "oa_damper_cmd": {"role": "required", "description": "Outdoor air / economizer damper command %"},
    "oa_damper_pos": {"role": "preferred", "description": "Damper position feedback % (may equal command)"},
    "oa_min_pct": {"role": "preferred", "description": "Minimum OA damper position setpoint %"},
    "cooling_cmd": {"role": "required", "description": "Cooling coil valve or mechanical cooling command %"},
    "heating_cmd": {"role": "optional", "description": "Heating coil command % — zero if no heating coil"},
    "oa_humidity": {"role": "optional", "description": "OA RH or enthalpy for enthalpy economizer"},
    "ra_humidity": {"role": "optional", "description": "Return air humidity for enthalpy economizer"},
    "return_damper_pos": {"role": "optional", "description": "Return damper feedback %"},
    "weather_oat": {"role": "preferred", "description": "Independent weather reference dry-bulb"},
    "override_active": {"role": "optional", "description": "Manual override / hand mode"},
    "economizer_enable": {"role": "optional", "description": "BAS economizer suitable signal"}
  },
  "ahu_mappings": {
    "AHU_1": {
      "timestamp": "timestamp_utc",
      "fan_cmd": "supply_fan_speed_pct",
      "fan_status": "supply_fan_status",
      "oat": "outside_air_temp_f",
      "rat": "return_air_temp_f",
      "mat": "mixed_air_temp_f",
      "sat": "discharge_air_temp_f",
      "sat_sp": "dat_reset_f",
      "oa_damper_cmd": "ex_dmpr_pos_fan_enable_pct",
      "oa_damper_pos": "ex_dmpr_pos_fan_enable_pct",
      "oa_min_pct": "oa_minimum_position_pct",
      "cooling_cmd": "chw_valve_pct",
      "heating_cmd": null,
      "mad_cmd": "mad_c",
      "notes": "No separate damper feedback — command used as proxy. No heating coil. No OA/RA humidity."
    },
    "AHU_2": {
      "timestamp": "timestamp_utc",
      "fan_cmd": "supply_fan_speed_pct",
      "fan_status": "supply_fan_status",
      "oat": "outside_air_temp_f",
      "rat": "return_air_temp_f",
      "mat": "mixed_air_temp_f",
      "sat": "discharge_air_temp_f",
      "sat_sp": "dat_reset_f",
      "oa_damper_cmd": "ex_dmpr_pos_fan_enable_pct",
      "oa_damper_pos": "ex_dmpr_pos_fan_enable_pct",
      "oa_min_pct": "oa_minimum_position_pct",
      "cooling_cmd": "chw_valve_pct",
      "heating_cmd": null,
      "mad_cmd": "mad_c_pct",
      "notes": "Same limitations as AHU_1."
    }
  }
}
