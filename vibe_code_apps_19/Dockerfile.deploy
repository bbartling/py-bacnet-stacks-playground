# Deploy image — pre-baked charts in site/ (build with package_dashboard.py first)
FROM python:3.12-slim

WORKDIR /app

COPY shared/ shared/
COPY haystack_rdf/ haystack_rdf/
COPY fdd_app/ fdd_app/

RUN pip install --no-cache-dir -r fdd_app/requirements.txt \
    && pip install --no-cache-dir gunicorn

WORKDIR /app/fdd_app

ENV PYTHONUNBUFFERED=1
ENV DASHBOARD_MODE=deploy
ENV ANALYST_ENABLED=1

EXPOSE 5000

CMD ["gunicorn", "-k", "uvicorn.workers.UvicornWorker", "--bind", "0.0.0.0:5000", "--timeout", "300", "asgi:app"]
