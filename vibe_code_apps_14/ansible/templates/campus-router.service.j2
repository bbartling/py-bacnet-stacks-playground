[Unit]
Description=Campus BACnet router (BACpypes3 ipv4-to-ipv4)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User={{ ansible_user }}
WorkingDirectory={{ campus_lab_dir }}
Environment=HOST_IP={{ campus_ip }}
Environment=CAMPUS_IP={{ campus_ip }}
Environment=BUILDING_LOCAL_IP={{ building_local_ip }}
Environment=BUILDING_IP={{ building_local_ip }}
Environment=VAV_IP={{ vav_ip }}
Environment=AHU_IP={{ ahu_ip }}
ExecStartPre={{ campus_lab_dir }}/scripts/render_campus_full_router_json.sh {{ campus_lab_dir }}/config/campus-full-router.rendered.json
ExecStart={{ campus_lab_dir }}/.venv/bin/python3 {{ campus_lab_dir }}/scripts/router_daemon.py --json {{ campus_lab_dir }}/config/campus-full-router.rendered.json --seconds 0
Restart=on-failure
RestartSec=5

[Install]
WantedBy=multi-user.target
