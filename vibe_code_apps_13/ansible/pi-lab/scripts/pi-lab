#!/usr/bin/env bash
# Thin CLI for Vibe13 Ansible Pi lab. No second orchestration framework.
set -euo pipefail
ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
cd "$ROOT"

INV="${PI_LAB_INVENTORY:-$ROOT/inventory.local.yml}"
CFG="$ROOT/ansible.cfg"
export ANSIBLE_CONFIG="$CFG"

usage() {
  cat <<'EOF'
Usage: ./scripts/pi-lab <command> [args]

  preflight [--ask-pass]
  bootstrap [--ask-pass] [--ask-become-pass]
  discover
  build --revision <SHA>
  deploy --revision <SHA>
  confirm-wiring [--confirmed]
  run --profile <raw-wire|mstp-smoke|mstp-soak> [--pair cb] [--duration 1h] --allow-tx
  status [--run <RUN_ID>]
  collect --run <RUN_ID>
  stop [--run <RUN_ID>]
  rollback --release <RELEASE_ID>

Requires inventory.local.yml (copy from inventory.example.yml).
Never stores SSH passwords. Tower BACnet is not a target.
TX requires confirm-wiring + run --allow-tx (wiring file alone is insufficient).
EOF
}

need_inv() {
  [[ -f "$INV" ]] || {
    echo "Missing $INV — cp inventory.example.yml inventory.local.yml" >&2
    exit 2
  }
}

ansible_bin() {
  if [[ -x "$ROOT/.venv/bin/ansible-playbook" ]]; then
    echo "$ROOT/.venv/bin/ansible-playbook"
  else
    echo "ansible-playbook"
  fi
}

ansible_cmd() {
  if [[ -x "$ROOT/.venv/bin/ansible" ]]; then
    echo "$ROOT/.venv/bin/ansible"
  else
    echo "ansible"
  fi
}

cmd="${1:-}"
shift || true

case "$cmd" in
  ""|-h|--help) usage; exit 0 ;;
  preflight)
    need_inv
    "$(ansible_bin)" -i "$INV" playbooks/preflight.yml "$@"
    ;;
  bootstrap)
    need_inv
    "$(ansible_bin)" -i "$INV" playbooks/bootstrap.yml "$@"
    ;;
  discover)
    need_inv
    RUN_ID="$(date -u +%Y%m%dT%H%M%SZ)"
    mkdir -p "$ROOT/reports/pi-lab/$RUN_ID"
    "$(ansible_bin)" -i "$INV" playbooks/discover.yml -e "lab_run_id=$RUN_ID" "$@"
    echo "Discovery evidence: $ROOT/reports/pi-lab/$RUN_ID"
    ;;
  run)
    need_inv
    PROFILE="mstp-smoke"
    PAIR="cb"
    DUR=""
    ALLOW_TX=false
    EXTRA=()
    while [[ $# -gt 0 ]]; do
      case "$1" in
        --profile) PROFILE="$2"; shift 2 ;;
        --pair) PAIR="$2"; shift 2 ;;
        --duration) DUR="$2"; shift 2 ;;
        --allow-tx) ALLOW_TX=true; shift ;;
        *) EXTRA+=("$1"); shift ;;
      esac
    done
    RUN_ID="$(date -u +%Y%m%dT%H%M%SZ)"
    python3 "$ROOT/scripts/lab_ids.py" check-run-id "$RUN_ID" >/dev/null
    EV=(-e "profile=$PROFILE" -e "pair=$PAIR" -e "run_id=$RUN_ID" -e "lab_allow_tx=$ALLOW_TX")
    [[ -n "$DUR" ]] && EV+=(-e "lab_duration=$DUR")
    "$(ansible_bin)" -i "$INV" playbooks/run.yml "${EV[@]}" "${EXTRA[@]}"
    echo "RUN_ID=$RUN_ID"
    ;;
  collect)
    need_inv
    RUN=""
    while [[ $# -gt 0 ]]; do
      case "$1" in
        --run) RUN="$2"; shift 2 ;;
        *) shift ;;
      esac
    done
    [[ -n "$RUN" ]] || { echo "--run required"; exit 2; }
    python3 "$ROOT/scripts/lab_ids.py" check-run-id "$RUN" >/dev/null
    "$(ansible_bin)" -i "$INV" playbooks/collect.yml -e "run_id=$RUN"
    ;;
  rollback)
    need_inv
    REL=""
    while [[ $# -gt 0 ]]; do
      case "$1" in
        --release) REL="$2"; shift 2 ;;
        *) shift ;;
      esac
    done
    [[ -n "$REL" ]] || { echo "--release required"; exit 2; }
    python3 "$ROOT/scripts/lab_ids.py" check-run-id "$REL" >/dev/null
    "$(ansible_bin)" -i "$INV" playbooks/rollback.yml -e "release_id=$REL"
    ;;
  build)
    REV=""
    while [[ $# -gt 0 ]]; do
      case "$1" in
        --revision) REV="$2"; shift 2 ;;
        *) echo "unknown: $1"; exit 2 ;;
      esac
    done
    [[ -n "$REV" ]] || { echo "--revision required"; exit 2; }
    python3 "$ROOT/scripts/lab_ids.py" check-run-id "$REV" >/dev/null
    "$ROOT/scripts/build_release.sh" "$REV"
    ;;
  deploy)
    need_inv
    REV=""
    EXTRA=()
    while [[ $# -gt 0 ]]; do
      case "$1" in
        --revision) REV="$2"; shift 2 ;;
        *) EXTRA+=("$1"); shift ;;
      esac
    done
    [[ -n "$REV" ]] || { echo "--revision required"; exit 2; }
    python3 "$ROOT/scripts/lab_ids.py" check-run-id "$REV" >/dev/null
    "$(ansible_bin)" -i "$INV" playbooks/deploy.yml -e "lab_revision=$REV" "${EXTRA[@]}"
    ;;
  confirm-wiring)
    CONFIRMED=false
    while [[ $# -gt 0 ]]; do
      case "$1" in
        --confirmed) CONFIRMED=true; shift ;;
        *) shift ;;
      esac
    done
    "$(ansible_bin)" -i "$INV" playbooks/confirm_wiring.yml -e "lab_wiring_confirmed=$CONFIRMED" "$@"
    ;;
  status)
    need_inv
    "$(ansible_bin)" -i "$INV" playbooks/status.yml "$@"
    ;;
  stop)
    need_inv
    "$(ansible_bin)" -i "$INV" playbooks/stop.yml "$@"
    ;;
  *)
    echo "Unknown command: $cmd" >&2
    usage
    exit 2
    ;;
esac
