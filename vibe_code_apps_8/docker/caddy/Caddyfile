# BAS Lite — Caddy in front of modular VOLTTRON App 8.
# Secrets come from .env (see .env.example). Generate password hash with:
#   docker run --rm caddy:2.8-alpine caddy hash-password --plaintext 'YOUR_PASSWORD'

:80 {
	redir https://{host}{uri} permanent
}

:443 {
	tls internal
	encode zstd gzip

	basic_auth {
		{$BAS_AUTH_USER} {$BAS_AUTH_HASH}
	}

	handle /app8* {
		reverse_proxy volttron:8080
	}

	handle {
		redir /app8/ 302
	}
}
