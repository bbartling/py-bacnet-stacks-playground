# Lab / developer: HTTP only, no Basic Auth.
# Gateway token is sent by the SPA (see nginx runtime config.runtime.js + api.ts).
# Caddy must not strip X-Bas-Lite-Gateway-Token — plain reverse_proxy only.
# Use: in .env set CADDYFILE=docker/caddy/Caddyfile.local-dev (see docker-compose.yml).

:80 {
	encode zstd gzip

	handle /app8/api/* {
		reverse_proxy api:8090
	}

	handle /api/v1/* {
		reverse_proxy api:8090
	}

	handle /openapi.json {
		reverse_proxy api:8090
	}

	handle {
		reverse_proxy frontend:80
	}
}
