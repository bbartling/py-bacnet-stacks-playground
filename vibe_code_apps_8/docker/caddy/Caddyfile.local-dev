# Lab / developer: HTTP only, no Basic Auth.
# When BAS_LITE_GATEWAY_TOKEN is set (see .env.example), the API requires the same
# X-Bas-Lite-Gateway-Token header as production Caddy — inject it here so the SPA
# (schedule save, etc.) works without switching to docker/caddy/Caddyfile.
# Use: in .env set CADDYFILE=docker/caddy/Caddyfile.local-dev (see docker-compose.yml).

:80 {
	encode zstd gzip

	handle /app8/api/* {
		reverse_proxy api:8090 {
			header_up -X-Bas-Lite-Gateway-Token
			header_up X-Bas-Lite-Gateway-Token "Bearer {$BAS_LITE_GATEWAY_TOKEN}"
		}
	}

	handle /api/v1/* {
		reverse_proxy api:8090 {
			header_up -X-Bas-Lite-Gateway-Token
			header_up X-Bas-Lite-Gateway-Token "Bearer {$BAS_LITE_GATEWAY_TOKEN}"
		}
	}

	handle /openapi.json {
		reverse_proxy api:8090 {
			header_up -X-Bas-Lite-Gateway-Token
			header_up X-Bas-Lite-Gateway-Token "Bearer {$BAS_LITE_GATEWAY_TOKEN}"
		}
	}

	handle {
		reverse_proxy frontend:80
	}
}
