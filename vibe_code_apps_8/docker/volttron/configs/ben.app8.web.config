{
  "agentid": "ben_app8_web",
  "route_prefix": "/app8",
  "app_title": "BAS Lite on VOLTTRON",
  "site_name": "edge-site",
  "max_trend_samples": 9500,
  "trend_interval_minutes": 5,
  "default_trend_retention_days": 31,
  "log_level": "INFO",
  "bacnet_devices": ["BensFakeAHU", "Zone1VAV"],
  "volttron_root": "/home/volttron",
  "vctl_path": "/home/volttron/env/bin/vctl",
  "volttron_home": "/home/volttron/datavolume/volttron_home",
  "allow_agent_lifecycle": true,
  "allow_driver_config_writes": true,
  "driver_store_root": "/home/volttron/datavolume/volttron_home/app8_driver_store"
}
