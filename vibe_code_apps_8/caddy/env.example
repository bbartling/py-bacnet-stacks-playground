# Copy to /etc/default/caddy-bas-lite and adjust (Raspberry Pi / Linux edge).
# Loaded by systemd before rendering the Caddyfile.

# Upstream BAS Lite web (default bind on the Pi).
CADDY_UPSTREAM=127.0.0.1:8080

# Web route prefix (must match app route prefix, e.g. /app8 or /app7).
CADDY_APP_PREFIX=/app8

# Set to 1 to require browser Basic Auth (username + bcrypt hash below).
CADDY_BASIC_AUTH_ENABLE=0
CADDY_BASIC_AUTH_USER=operator
# Output of: caddy hash-password --plaintext 'your-secret-password'
CADDY_BASIC_AUTH_HASH=

# Set to 1 to listen on :443 with TLS (paths required).
CADDY_TLS_ENABLE=0
CADDY_TLS_CERT=/etc/caddy/ssl/bas-lite.crt
CADDY_TLS_KEY=/etc/caddy/ssl/bas-lite.key

# Optional: hostname for TLS SNI / redirects (defaults to request host).
# CADDY_PUBLIC_HOST=192.168.204.12
