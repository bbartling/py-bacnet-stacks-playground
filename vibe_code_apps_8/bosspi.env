# Append to .env on Boss Pi after: cp .env.example .env
# (Or: cat bosspi.env >> .env)
#
# LAN UI from your laptop — Caddy on all interfaces, lab ports 18080/18443.
CADDY_HTTP_PORTS=18080:80
CADDY_HTTPS_PORTS=18443:443
#
# Host UDP 47808 is often taken by another BACnet runtime. Map host 47809 -> container 47808
# so the stack starts. Field devices still use 47808 on the wire; free 47808 on the Pi later
# and remove this line (or set BACNET_UDP_HOST_PORT=47808) for standard BACnet to this stack.
BACNET_UDP_HOST_PORT=47809
