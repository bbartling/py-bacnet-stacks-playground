# Copy to .env next to docker-compose.yml. Replace every secret before production.
#
# Boss Pi: after sync from your PC, on the Pi run ./scripts/bootstrap-bas-lite.sh (merges bosspi.env, generates
# BACNET_RPC_API_KEY if still the placeholder below, then docker compose up -d).

# --- Host ports (defaults avoid :80 / :8080 clashes on dev machines) ---
DIY_BACNET_HOST_PORT=28090
CADDY_HTTP_HOST_PORT=18080
CADDY_HTTPS_HOST_PORT=18443

# --- LAN publish (Boss Pi: open UI from your laptop on the same network) ---
# Default is loopback-only (127.0.0.1:port). Do NOT use CADDY_HTTP_BIND=0.0.0.0 — a Windows CRLF .env can break it
# ("Invalid ip address: 0.0.0."). Instead use two-part port specs (Docker binds all interfaces):
#   CADDY_HTTP_PORTS=18080:80
#   CADDY_HTTPS_PORTS=18443:443
# Optional JSON-RPC from other LAN hosts (usually avoid): DIY_BACNET_PORTS=28090:8080

# --- Caddy (HTTPS + Basic Auth) ---

# Operator UI login. Password hash (example is for password BasLiteOT-ChangeMe! — rotate immediately):

#   docker run --rm caddy:2.8-alpine caddy hash-password --plaintext 'YOUR_PASSWORD'

BAS_AUTH_USER=operator

# Quote the hash so Docker Compose does not treat `$…` as variable interpolation.
BAS_AUTH_HASH='$2a$14$fz5XqtSl3IQ91Y9XIv9cLO1kQFJWfKWf0wHcyEmSXZLPySa/ZC/5a'



# Shared secret: Caddy adds X-Bas-Lite-Gateway-Token: Bearer … on API routes only.

# The React app never sees this; it prevents calling the API container directly if something on the LAN can reach Docker bridge IPs.

BAS_LITE_GATEWAY_TOKEN=change-me-to-a-long-random-string



# Compose defaults to docker/caddy/Caddyfile.local-dev (HTTP only, no gateway header).
# For TLS + Basic Auth + gateway token on API routes, set:
#   CADDYFILE=docker/caddy/Caddyfile
# and set BAS_LITE_GATEWAY_TOKEN / BAS_AUTH_* as documented in docs/BOSS_PI_BAS_LITE_DOCKER.md.



# --- diy-bacnet-server (JSON-RPC + BACnet/IP) ---

# UDP 47808 is the BACnet/IP default — only one listener on the host. If Docker says "bind: address already in use",
# find the owner: sudo ss -ulnp | grep 47808  (often another BACnet stack) and stop it, or for RPC-only
# lab you may set BACNET_UDP_HOST_PORT=47809 (field gear on 47808 will not reach this stack without extra routing).
#BACNET_UDP_HOST_PORT=47808

# When set, diy-bacnet-server requires Authorization: Bearer … on JSON-RPC (except server_hello).

# easy-aso reads the same value from BACNET_RPC_API_KEY for outbound RPC.

BACNET_RPC_API_KEY=change-me-another-long-random-string



SUPERVISOR_BACNET_RPC_URL=http://diy-bacnet:8080

SUPERVISOR_BACNET_RPC_ENTRYPOINT=/api

BAS_LITE_SITE_NAME=Boss Pi BAS Lite

# --- Optional SMTP secret override (recommended) ---
# If set, BAS Lite uses this value for SMTP auth at runtime and does not return real password in API/UI payloads.
#BAS_LITE_SMTP_PASSWORD=

# --- Optional easy-aso OAT share agent (compose profile: oat) ---
# docker compose --profile oat up -d easy-aso-oat
# Reads one BACnet object via diy-bacnet JSON-RPC and writes the same value to one or more targets (no second BACnet UDP stack).
# OAT_TARGET_WRITES is a JSON array, e.g. [{"device":"10.0.0.5","object":"analog-value,2","priority":16}]
#OAT_SOURCE_DEVICE=10.0.0.1
#OAT_SOURCE_OBJECT=analog-input,1
#OAT_TARGET_WRITES=[]
#OAT_INTERVAL_SEC=300

# --- Optional EasyASO RpcDocked agents (compose profile: agents) ---
# Image installs easy-aso[platform]==0.1.7 from PyPI. Three services share one Dockerfile:
#   docker compose --profile agents up -d easy-aso-agent-oat easy-aso-agent-gl36-vav easy-aso-agent-gl36-ahu
# OAT share (same env keys as easy-aso-oat profile; device fields are BACnet *instance* strings for diy-bacnet RPC):
#EASY_ASO_OAT_STEP_SEC=300
#OAT_SOURCE_DEVICE=3456789
#OAT_SOURCE_OBJECT=analog-input,1
# OAT_TARGET_WRITES must stay valid JSON in .env (quote the whole value on Windows):
#OAT_TARGET_WRITES="[{\"device\":\"3456790\",\"object\":\"analog-value,2\",\"priority\":16}]"
# GL36 VAV request + trim-respond feed (single-line JSON):
#EASY_ASO_GL36_VAV_STEP_SEC=60
#EASY_ASO_GL36_VAV_CONFIG="{\"zones\":[{\"device\":\"3456790\",\"cooling_request\":\"analog-value,1\",\"heating_request\":\"analog-value,2\"}],\"cooling_threshold\":0.05,\"heating_threshold\":0.05,\"summary_device\":\"3456789\",\"cooling_count_object\":\"analog-value,20\",\"heating_count_object\":\"analog-value,21\",\"trim_respond_object\":\"analog-value,22\"}"
# GL36-style AHU supply-air reset (single-line JSON):
#EASY_ASO_GL36_AHU_STEP_SEC=120
#EASY_ASO_GL36_AHU_CONFIG="{\"ahu_device\":\"3456789\",\"supply_air_setpoint\":\"analog-value,5\",\"supply_air_temp\":\"analog-input,1\",\"zones\":[{\"device\":\"3456790\",\"zone_temp\":\"analog-value,3\"}],\"cooling_setpoint_f\":72,\"band_f\":1.5,\"min_sat_f\":52,\"max_sat_f\":60,\"nominal_sat_f\":55,\"reset_gain\":-2}"
# Optional extra agent service: merge docker-compose.easy-aso-agents.example.yml with -f.

# --- Frontend image build (Boss Pi / low RAM): Node heap for Vite + Plotly inside Docker build ---
#FRONTEND_NODE_MAX_OLD_SPACE=2048
# Skip Vite/npm inside Docker when frontend/dist is synced (deploy -PrebuiltFrontend sets this on the Pi):
#FRONTEND_SKIP_NODE_BUILD=0

