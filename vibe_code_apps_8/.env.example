# Copy to .env next to docker-compose.yml (optional for quick lab; recommended on a Pi).
# Use the SAME value in diy-bacnet-server so JSON-RPC Bearer auth matches both sides.
# See: https://github.com/bbartling/diy-bacnet-server/blob/master/docs/environment.md
BACNET_RPC_API_KEY=

# Optional: BACnet Schedule object Name in diy CSV (must match a Schedule row).
# DIY_SCHEDULE_OBJECT_NAME=WeeklyOccupancy
