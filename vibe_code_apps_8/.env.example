# Copy to .env next to docker-compose.yml.

# --- App 8 / VOLTTRON ports (host) ---
# Inside the container VOLTTRON web stays on :8080 and VIP on :22916.
APP8_HTTP_HOST_PORT=18080
APP8_ZMQ_HOST_PORT=22916

# --- Optional: Caddy in front (compose profile "caddy") ---
#   pwsh: ./rebuild-bas-lite.ps1 -Caddy
#   bash: ./rebuild-bas-lite.sh --caddy
# Or: COMPOSE_PROFILES=caddy
COMPOSE_PROFILES=
CADDY_HTTP_PORT=18088
CADDY_HTTPS_PORT=18443
# Lab HTTP only (default):
# CADDYFILE=docker/caddy/Caddyfile.local-dev
# TLS + basic auth (set BAS_AUTH_* then point CADDYFILE at docker/caddy/Caddyfile):
# CADDYFILE=docker/caddy/Caddyfile
BAS_AUTH_USER=operator
BAS_AUTH_HASH='$2a$14$fz5XqtSl3IQ91Y9XIv9cLO1kQFJWfKWf0wHcyEmSXZLPySa/ZC/5a'

# --- VOLTTRON_HOME on the named volume (custom bas-lite image) ---
VOLTTRON_HOME=/home/volttron/datavolume/volttron_home

# --- Official image (reference only; default stack uses Dockerfile) ---
# https://hub.docker.com/r/eclipsevolttron/volttron
VOLTTRON_IMAGE=eclipsevolttron/volttron:v10
